# Copy to .env at the repo root. Every variable is documented in docs/ARCHITECTURE.md.
# Python services read OPENAD_* via openad.config.Settings. The web app reads VITE_*.

# ---------------------------------------------------------------- chain / contracts
OPENAD_CHAIN_ID=31337
OPENAD_RPC_URL=http://127.0.0.1:8545
# Directory containing <chainId>.json deployments artifacts (relative to repo root or absolute).
OPENAD_DEPLOYMENTS_DIR=contracts/deployments
# Extra RPCs for resolving NFT_REF creatives on other chains (optional).
# OPENAD_RPC_URL_1=https://...
# OPENAD_RPC_URL_8453=https://mainnet.base.org

# ---------------------------------------------------------------- database
# Postgres in docker compose (host 15432 → container 5432). Unit tests use sqlite.
OPENAD_DATABASE_URL=postgresql+asyncpg://openad:openad@127.0.0.1:15432/openad

# ---------------------------------------------------------------- api
OPENAD_ENV=dev                       # dev | staging | prod
OPENAD_LOG_LEVEL=INFO
OPENAD_API_HOST=127.0.0.1
OPENAD_API_PORT=8000
# Public base URL of this API, used to build mediaUrl in serve responses.
OPENAD_PUBLIC_URL=http://localhost:8000
# Comma-separated allowed origins for the web app (CORS). Serve endpoints are always public.
OPENAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- serving edge
OPENAD_SERVE_TTL_SECONDS=30
OPENAD_SERVE_ENFORCE_ORIGIN=false
OPENAD_MEDIA_CACHE_DIR=api/.cache/media
OPENAD_MAX_MEDIA_BYTES=2097152
OPENAD_IPFS_GATEWAY=https://ipfs.io/ipfs/
OPENAD_VERIFY_INTERVAL_SECONDS=21600
# OPENAD_SAFE_BROWSING_KEY=

# ---------------------------------------------------------------- indexer
OPENAD_INDEXER_POLL_SECONDS=2
OPENAD_INDEXER_BATCH_BLOCKS=2000
OPENAD_INDEXER_CONFIRMATIONS=1       # 31337 uses latest minus this (Anvil `safe` is ignored)
OPENAD_INDEXER_REORG_DEPTH=32

# ---------------------------------------------------------------- local sim (ADR-0012; opt-in `.\scripts\sim-up.cmd`, never started by dev-up)
# OPENAD_SIM_RPC_URL=http://127.0.0.1:8545
# OPENAD_SIM_API_URL=http://localhost:8000
# OPENAD_SIM_CHAIN_ID=31337
# OPENAD_SIM_TICK_SECONDS=20
# OPENAD_SIM_CONTROL_PORT=8610
# OPENAD_SIM_SEED=1
# OPENAD_SIM_DEPLOYMENTS_DIR=contracts/deployments
# OPENAD_SIM_USDC_TARGET=5000000000

# ---------------------------------------------------------------- auth (SIWE)
OPENAD_SESSION_SECRET=change-me-in-real-environments
OPENAD_SESSION_TTL_SECONDS=86400

# ---------------------------------------------------------------- web (Vite)
VITE_API_URL=http://localhost:8000
VITE_CHAIN_ID=31337
# VITE_WALLETCONNECT_PROJECT_ID=
# Optional embedded wallet (ADR-0011). Leave unset for RainbowKit-only.
# VITE_TURNKEY_ORGANIZATION_ID=
# VITE_TURNKEY_AUTH_PROXY_CONFIG_ID=

# ---------------------------------------------------------------- contracts (Moccasin)
# RPC URLs referenced by contracts/moccasin.toml. Deploy keys are Moccasin encrypted wallets,
# never env vars.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# BASESCAN_API_KEY=
