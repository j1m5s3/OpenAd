# Copy to .env at the repo root. Every variable is documented in docs/ARCHITECTURE.md.
# Python services read OPENAD_* via openad.config.Settings. The web app reads VITE_*.

# ---------------------------------------------------------------- chain / contracts
OPENAD_CHAIN_ID=31337
OPENAD_RPC_URL=http://127.0.0.1:8545
# Directory containing <chainId>.json deployments artifacts (relative to repo root or absolute).
OPENAD_DEPLOYMENTS_DIR=contracts/deployments
# Extra RPCs for resolving NFT_REF creatives on other chains (optional).
# OPENAD_RPC_URL_1=https://...
# OPENAD_RPC_URL_8453=https://mainnet.base.org

# ---------------------------------------------------------------- database
# Postgres in docker compose (host 15432 → container 5432). Unit tests use sqlite.
OPENAD_DATABASE_URL=postgresql+asyncpg://openad:openad@127.0.0.1:15432/openad
# Per-process connection pool (ignored for sqlite URLs); the values below are the defaults.
# Cloud Run sets smaller pools on every service (api 4/2, indexer and settler 2/1 each): see
# docs/deploy-gcp.md "Connection budget".
# OPENAD_DB_POOL_SIZE=5
# OPENAD_DB_MAX_OVERFLOW=5
# OPENAD_DB_POOL_TIMEOUT=30
# OPENAD_DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------- api
OPENAD_ENV=dev                       # dev | staging | prod
OPENAD_LOG_LEVEL=INFO
OPENAD_API_HOST=127.0.0.1
OPENAD_API_PORT=8000
# Public base URL of this API, used to build mediaUrl in serve responses.
OPENAD_PUBLIC_URL=http://localhost:8000
# Comma-separated allowed origins for the web app (CORS). Serve endpoints are always public.
# Each origin's host must be `localhost`, an IPv4 address, or a dotted hostname: viem's
# `createSiweMessage` (used by the web app and the sim, ADR-0009 amendment) rejects IPv6
# literals and single-label hosts other than `localhost` (e.g. `devbox:5173`, `LOCALHOST:5173`).
OPENAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- serving edge
OPENAD_SERVE_TTL_SECONDS=30
# Paid (lease/campaign) creatives serve only when the request's Origin/Referer host is the
# slot's domain or a subdomain of it; other pages get the house ad or empty. Off for local
# development; staging and prod set it to true in infra/gcp/services/api.yaml.
OPENAD_SERVE_ENFORCE_ORIGIN=false
OPENAD_MEDIA_CACHE_DIR=api/.cache/media
# Media cache backend: local (default disk cache) or gcs (ADR-0017; required on Cloud Run,
# where the indexer and api are separate containers with no shared disk).
OPENAD_MEDIA_BACKEND=local
# OPENAD_MEDIA_GCS_BUCKET=openad-media-<project>-<env>
OPENAD_MEDIA_GCS_PREFIX=media
OPENAD_MAX_MEDIA_BYTES=2097152
OPENAD_IPFS_GATEWAY=https://ipfs.io/ipfs/
OPENAD_VERIFY_INTERVAL_SECONDS=21600
# Overall deadline around one fetch_media call (connect + every redirect hop + the body), on
# top of the per-read httpx timeout; catches a "slow-drip" host (PR #17, docs/threat-model.md T18).
OPENAD_MEDIA_FETCH_DEADLINE_SECONDS=30
# Wall-clock budget for one indexer verify pass; creatives it doesn't reach stay pending for the
# next pass instead of blocking block indexing (PR #17, docs/threat-model.md T18).
OPENAD_VERIFY_PASS_BUDGET_SECONDS=20
# Reserved for a future phishing/malware check on click URLs (ROADMAP 7.19); nothing reads it yet.
# OPENAD_SAFE_BROWSING_KEY=

# ---------------------------------------------------------------- indexer
OPENAD_INDEXER_POLL_SECONDS=2
OPENAD_INDEXER_BATCH_BLOCKS=2000
OPENAD_INDEXER_CONFIRMATIONS=1       # 31337 uses latest minus this (Anvil `safe` is ignored)
OPENAD_INDEXER_REORG_DEPTH=32

# ---------------------------------------------------------------- local sim (ADR-0012; opt-in `.\scripts\sim-up.cmd`, never started by dev-up)
# OPENAD_SIM_RPC_URL=http://127.0.0.1:8545
# OPENAD_SIM_API_URL=http://localhost:8000
# OPENAD_SIM_CHAIN_ID=31337
# OPENAD_SIM_TICK_SECONDS=20
# OPENAD_SIM_CONTROL_PORT=8610
# OPENAD_SIM_SEED=1
# OPENAD_SIM_DEPLOYMENTS_DIR=contracts/deployments
# OPENAD_SIM_USDC_TARGET=5000000000
# Origin the personas sign in (SIWE) as: the web app's, never the API's (ADR-0009 amendment).
# OPENAD_SIM_WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- auth (SIWE)
OPENAD_SESSION_SECRET=change-me-in-real-environments
OPENAD_SESSION_TTL_SECONDS=86400
# Web origins a SIWE message may be bound to (its `domain` = host:port, its `URI` = the same
# origin; ADR-0009 amendment). Comma-separated; unset follows OPENAD_CORS_ORIGINS. Same host
# rule as OPENAD_CORS_ORIGINS above (viem rejects IPv6 literals and single-label hosts other
# than `localhost`).
# OPENAD_SIWE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Best-effort, per-instance limit on POST /v1/auth/nonce and /verify (429 + Retry-After).
# 0 (the default) disables it.
# OPENAD_AUTH_RATE_LIMIT_PER_MINUTE=0
# Proxies in front of the api that append to X-Forwarded-For. It picks the client key for this
# limit and for the CPC click burst rule: 0 (the default) is the TCP peer; N is the N-th
# X-Forwarded-For entry from the right. With 0 in staging or prod the burst rule is skipped:
# on Cloud Run the peer is Google's front end (inferred; verify before deploy). Verify your
# proxy chain before raising it (docs/deploy-gcp.md).
# OPENAD_TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------- CPC clicks + settler (ADR-0014)
OPENAD_CLICK_HMAC_SECRET=change-me-click-hmac
OPENAD_CLICK_IVT=true
OPENAD_CLICK_MAX_PER_CAMPAIGN_HOUR=120
# Settler process only (`python -m openad.settler`). Never set on the HTTP API container.
# OPENAD_SETTLER_POLL_SECONDS=15
# Staging and prod use the key of a dedicated, gas-only settler EOA, never the deployer's or the
# owner's (docs/deploy-sepolia.md); off chain 31337 the settler refuses to start if its key owns
# CampaignVault or is the deployer.
# Anvil account #0 (local only; matches docker-compose Foundry key):
# OPENAD_SETTLER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---------------------------------------------------------------- web (Vite)
VITE_API_URL=http://localhost:8000
VITE_CHAIN_ID=31337
# VITE_WALLETCONNECT_PROJECT_ID=  # unset/empty: injected (browser) wallets only, never a fake id
# Optional embedded wallet (ADR-0011). Leave unset for RainbowKit-only.
# VITE_TURNKEY_ORGANIZATION_ID=
# VITE_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Hosted user guide (ADR-0015). Comment out to hide the nav Guide link and
# in-app “Learn more” links. Field hints still render locally.
VITE_GUIDE_URL=https://pam-2.gitbook.io/open-ad-docs
# Demo mode (ADR-0016): in-memory fixtures + simulated wallet, no API/chain calls.
# VITE_DEMO_MODE=1  # static demo build, no API/chain (ADR-0016)
# Router mode. "hash" picks createHashRouter, for a static host with no SPA fallback (`npm run
# build:demo` sets this itself); unset keeps createBrowserRouter.
# VITE_ROUTER=hash
# Sourcemaps are off by default (ROADMAP 6.7). This is a shell-only setting, not a `.env` one:
# `web/vite.config.ts` reads it from `process.env` directly, and Vite does not load `.env` files
# into the config file itself (only into application code) — so setting it here has no effect.
# To debug a production build locally: `VITE_SOURCEMAP=1 npm run build -w web`. Never enable
# this for a deployed image.
# Normal (non-demo) build only: link to the hosted demo shown from the /why page's "Try the
# demo" CTA. Leave unset to hide that CTA in normal builds.
# VITE_DEMO_URL=https://demo.openad.example
# Embed script URL for publisher snippets (ROADMAP 6.3). Leave unset to use the versioned script
# the web build ships at `embed/open-ad.v1.js` (same origin as the app, resolved against
# `document.baseURI`). Set this only if the embed is hosted elsewhere, e.g. a CDN.
# VITE_EMBED_SCRIPT_URL=https://cdn.example.com/open-ad.v1.js

# ---------------------------------------------------------------- contracts (Moccasin)
# RPC URLs referenced by contracts/moccasin.toml. Deploy keys are Moccasin encrypted wallets,
# never env vars.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# BASESCAN_API_KEY=
# The CampaignVault settler's address (never its key), read by script/deploy.py and
# script/set_settler.py. Required off Anvil (a dedicated, gas-only EOA, never the deployer);
# unset on Anvil means the deployer, account #0. For a Sepolia or Base deploy, export it in the
# shell rather than setting it here: Moccasin loads this file on every network, so the next local
# Anvil deploy would make that EOA the local settler and local CPC settlement would stop.
# OPENAD_SETTLER_ADDRESS=
