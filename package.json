{
  "name": "openad",
  "private": true,
  "description": "OpenAd monorepo root: npm workspaces for the TypeScript packages (web, embed). Python packages (contracts, api) are managed with uv.",
  "workspaces": [
    "web",
    "embed",
    "e2e",
    "sim"
  ],
  "scripts": {
    "stack:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "stack:up": "powershell -ExecutionPolicy Bypass -File scripts/dev-up.ps1",
    "stack:down": "powershell -ExecutionPolicy Bypass -File scripts/dev-down.ps1",
    "stack:sim": "powershell -ExecutionPolicy Bypass -File scripts/sim-up.ps1",
    "stack:sim:down": "powershell -ExecutionPolicy Bypass -File scripts/sim-down.ps1",
    "dev:web": "npm run dev -w web",
    "dev:embed": "npm run dev -w embed",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w web -w embed -w sim",
    "test:e2e": "npm run test -w e2e",
    "format": "prettier --write \"{web,embed}/**/*.{ts,tsx,css,json,md}\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"{web,embed}/**/*.{ts,tsx,css,json,md}\" \"docs/**/*.md\" \"*.md\""
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
