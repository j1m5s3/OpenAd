# Rendered by nginxinc/nginx-unprivileged's docker-entrypoint envsubst step: only variables
# that are ACTUAL environment variables at container start (e.g. ${PORT}, ${CSP_CONNECT_SRC},
# ${CSP_IMG_SRC}) are substituted — nginx's own $uri/$http_upgrade/... are untouched since they
# aren't env vars, and a variable that is NOT defined at container start is left in the header
# literally instead of being substituted away, so every CSP-bearing ENV below must always be set.
# See web/Dockerfile (ENV PORT / ENV CSP_CONNECT_SRC / ENV CSP_IMG_SRC) and
# infra/gcp/services/web*.yaml.

# nginx only inherits a parent block's `add_header` directives into a location that declares
# NONE of its own; both `/assets/` and `/` below also set their own Cache-Control, which
# otherwise silently drops every server-level security header for exactly those two locations
# — the ones that actually serve content. So each location below repeats the full header set
# instead of relying on inheritance from the server block.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Repeated verbatim in every location block below (nginx does not merge add_header sets
    # across levels — a location with its own add_header must restate all of them).
    # /health, not /healthz: Cloud Run's front end reserves some paths ending in "z" and answers
    # /healthz on a *.run.app URL with its own 404 before the request reaches this container
    # (seen on the first staging deploy, 2026-09-26). Don't add a location whose path ends in z.
    location = /health {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src ${CSP_IMG_SRC}; font-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'" always;
        default_type text/plain;
        return 200 "ok";
    }

    # The versioned embed script (`web/vite.config.ts`'s `embedScriptCopy` plugin,
    # ADR-0017 amendment): loaded via `<script type="module" src="...">` on publisher domains —
    # a *cross-origin* request. Browsers fetch module scripts in CORS mode (unlike a classic
    # `<script src>`, which needs no CORS header at all), so with no ACAO header here the
    # browser blocks the response on every publisher domain except this one. `Access-Control-
    # Allow-Origin: *` is safe: the file is public, static, and carries no credentials, the same
    # reasoning as `/v1/serve/*`'s CORS (`docs/ARCHITECTURE.md` §3.4). `Cross-Origin-Resource-
    # Policy: cross-origin` is required too, independently of CORS, so Chrome's CORP check (which
    # blocks a cross-origin subresource fetch even when ACAO would allow it) doesn't also block
    # this one. The path is versioned (`open-ad.v1.js`), so a day-long cache is safe; a future
    # breaking change ships as `open-ad.v2.js` instead of overwriting this one.
    location /embed/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src ${CSP_IMG_SRC}; font-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src ${CSP_IMG_SRC}; font-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
        # connect-src is the enforcement point for ADR-0016 in the demo build: the demo
        # variant's CSP_CONNECT_SRC is 'self' only, so even a bug that re-enabled a real
        # fetch/RPC/WS call would be blocked by the browser, not just by the JS network guard.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src ${CSP_IMG_SRC}; font-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
