{
  "name": "@openad/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAd web app: Discover, Supply, and Campaigns (Vite + React + Tailwind + RainbowKit + wagmi).",
  "scripts": {
    "dev": "npm run sync:deployments && npm run sync:openapi && vite",
    "build": "npm run sync:deployments && npm run sync:openapi && tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "node scripts/build-demo.mjs",
    "preview": "vite preview",
    "typecheck": "npm run sync:deployments && npm run sync:openapi && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "sync:deployments": "node scripts/sync-deployments.mjs",
    "sync:openapi": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "@openad/embed": "*",
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@tanstack/react-query": "^5.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "viem": "^2.20.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
