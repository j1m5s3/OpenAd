{
  "name": "@openad/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAd web app: public marketplace, publisher dashboard, advertiser dashboard (Vite + React + MUI + wagmi).",
  "scripts": {
    "dev": "npm run sync:deployments && vite",
    "build": "npm run sync:deployments && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "npm run sync:deployments && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "sync:deployments": "node scripts/sync-deployments.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@tanstack/react-query": "^5.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "viem": "^2.20.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
